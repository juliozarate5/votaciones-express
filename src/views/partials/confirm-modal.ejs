<div
  id="app-confirm-modal"
  class="fixed inset-0 z-[60] hidden items-end justify-center bg-slate-900/50 p-4 sm:items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="app-confirm-title"
  aria-describedby="app-confirm-message"
  aria-hidden="true"
>
  <div class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-200">
    <div id="app-confirm-header" class="border-b border-slate-100 bg-slate-50 px-5 py-4">
      <p id="app-confirm-title" class="text-lg font-bold text-brand-900">Confirmar</p>
      <p id="app-confirm-message" class="mt-1 text-sm leading-relaxed text-slate-600"></p>
    </div>
    <div class="flex flex-col gap-2 px-5 py-4 sm:flex-row-reverse">
      <button
        type="button"
        id="app-confirm-ok"
        class="w-full rounded-xl bg-brand-700 px-4 py-3 text-sm font-bold text-white hover:bg-brand-900 sm:w-auto sm:min-w-[9rem]"
      >
        Confirmar
      </button>
      <button
        type="button"
        id="app-confirm-cancel"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 sm:w-auto sm:min-w-[8rem]"
      >
        Cancelar
      </button>
    </div>
  </div>
</div>
