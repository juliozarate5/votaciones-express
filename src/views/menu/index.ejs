<section>
  <div class="mb-6">
    <h1 class="text-2xl font-semibold text-brand-900">Menú principal</h1>
    <p class="mt-1 text-sm text-slate-600">Elige cómo quieres reportar o consulta tus resultados.</p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    <a href="/report/realtime" class="menu-card group">
      <span class="menu-card-title">Tiempo real</span>
      <span class="menu-card-desc">Envía voto a voto (mujer u hombre)</span>
    </a>

    <a href="/report/total" class="menu-card group">
      <span class="menu-card-title">Total final</span>
      <span class="menu-card-desc">Reporta totales al cerrar la mesa</span>
    </a>

    <a href="/dashboard/mine" class="menu-card group">
      <span class="menu-card-title">Mi reporte</span>
      <span class="menu-card-desc">Consulta tiempo real y totales tuyos</span>
    </a>

    <% if (isAdmin) { %>
      <a href="/dashboard/admin" class="menu-card group border-accent-400/40">
        <span class="menu-card-title text-accent-500">Reporte de todos</span>
        <span class="menu-card-desc">Tabla, Excel, PDF e impresión</span>
      </a>
      <a href="/dashboard/stats" class="menu-card group border-accent-400/40">
        <span class="menu-card-title text-accent-500">Dashboard</span>
        <span class="menu-card-desc">Gráficos por usuario y género</span>
      </a>
      <a href="/dashboard/admin/reset" class="menu-card group border-rose-300/70 bg-rose-50/60">
        <span class="menu-card-title text-rose-800">Resetear base de datos</span>
        <span class="menu-card-desc">Borra todos los votos (requiere confirmación)</span>
      </a>
    <% } %>
  </div>
</section>
