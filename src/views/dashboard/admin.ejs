<section class="print-area">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between no-print">
    <div>
      <%- include('../partials/back-link', { backHref: '/menu', backLabel: 'Volver al menú' }) %>
      <h1 class="mt-1 text-2xl font-semibold text-brand-900">Reporte de todos</h1>
      <p class="mt-1 text-sm text-slate-600">Totales reportados. Clic en el nombre para ver historial.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/dashboard/stats" class="action-btn action-btn-secondary">Dashboard</a>
      <a href="/dashboard/admin/export/excel" class="action-btn action-btn-secondary">Excel</a>
      <a href="/dashboard/admin/export/pdf" class="action-btn action-btn-secondary">PDF</a>
      <button type="button" onclick="window.print()" class="action-btn action-btn-primary">Imprimir</button>
    </div>
  </div>

  <div class="mb-2 print-only">
    <h1 class="text-xl font-bold text-brand-900">Reporte oficial de Votaciones</h1>
    <p class="text-sm text-slate-600">Generado: <%= new Date().toLocaleString('es-CO') %></p>
  </div>

  <div class="mb-6 grid grid-cols-3 gap-3">
    <div class="stat-box">
      <p class="stat-label">Mujeres</p>
      <p class="stat-value text-brand-700"><%= official.grand.women %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">Hombres</p>
      <p class="stat-value text-brand-700"><%= official.grand.men %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">Total</p>
      <p class="stat-value text-accent-500"><%= official.grand.total %></p>
    </div>
  </div>

  <% if (!official.rows.length) { %>
    <div class="rounded-2xl border border-brand-100 bg-white/90 p-4 shadow-sm">
      <p class="text-sm text-slate-500">Todavía no hay reportes.</p>
    </div>
  <% } else { %>
    <div class="admin-cards space-y-3 screen-only">
      <% official.rows.forEach(function (row) { %>
        <article class="reporter-card">
          <button
            type="button"
            class="reporter-card-name text-left underline decoration-brand-500/40 underline-offset-2 hover:text-brand-700"
            data-reporter-key="<%= row.reporterKey %>"
          >
            <%= row.reporterName %>
          </button>
          <div class="reporter-card-block">
            <div class="reporter-card-grid">
              <div>
                <span class="reporter-card-label">Mujeres</span>
                <strong><%= row.women %></strong>
              </div>
              <div>
                <span class="reporter-card-label">Hombres</span>
                <strong><%= row.men %></strong>
              </div>
              <div>
                <span class="reporter-card-label">Total</span>
                <strong class="text-accent-500"><%= row.total %></strong>
              </div>
            </div>
            <% if (row.reportedAt) { %>
              <p class="mt-2 text-center text-xs text-slate-500">Actualizado: <%= formatDateTime(row.reportedAt) %></p>
            <% } %>
            <% if (row.totalReports > 0) { %>
              <p class="mt-1 text-center text-xs text-slate-400"><%= row.totalReports %> envío(s) de total</p>
            <% } %>
          </div>
        </article>
      <% }) %>

      <article class="reporter-card reporter-card-total">
        <h3 class="reporter-card-name">Total general</h3>
        <div class="reporter-card-block">
          <div class="reporter-card-grid">
            <div>
              <span class="reporter-card-label">Mujeres</span>
              <strong><%= official.grand.women %></strong>
            </div>
            <div>
              <span class="reporter-card-label">Hombres</span>
              <strong><%= official.grand.men %></strong>
            </div>
            <div>
              <span class="reporter-card-label">Total</span>
              <strong class="text-accent-500"><%= official.grand.total %></strong>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="admin-table overflow-x-auto rounded-2xl border border-brand-100 bg-white/90 p-4 shadow-sm screen-only">
      <table class="min-w-full text-left text-sm report-table">
        <thead class="border-b border-slate-200 text-slate-500">
          <tr>
            <th class="py-2 pr-3 font-medium sticky left-0 bg-white">Persona</th>
            <th class="py-2 pr-3 font-medium">Mujeres</th>
            <th class="py-2 pr-3 font-medium">Hombres</th>
            <th class="py-2 pr-3 font-medium">Total</th>
            <th class="py-2 font-medium">Actualizado</th>
          </tr>
        </thead>
        <tbody>
          <% official.rows.forEach(function (row) { %>
            <tr class="border-b border-slate-100">
              <td class="py-2 pr-3 font-medium sticky left-0 bg-white">
                <button
                  type="button"
                  class="text-brand-900 underline decoration-brand-500/40 underline-offset-2 hover:text-brand-700"
                  data-reporter-key="<%= row.reporterKey %>"
                >
                  <%= row.reporterName %>
                </button>
              </td>
              <td class="py-2 pr-3"><%= row.women %></td>
              <td class="py-2 pr-3"><%= row.men %></td>
              <td class="py-2 pr-3 font-semibold"><%= row.total %></td>
              <td class="py-2 whitespace-nowrap text-xs"><%= formatDateTime(row.reportedAt) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr class="font-semibold text-brand-900 border-t border-slate-200">
            <td class="pt-3 pr-3 sticky left-0 bg-white">TOTAL</td>
            <td class="pt-3 pr-3"><%= official.grand.women %></td>
            <td class="pt-3 pr-3"><%= official.grand.men %></td>
            <td class="pt-3 pr-3"><%= official.grand.total %></td>
            <td class="pt-3">—</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="print-only official-print">
      <table class="min-w-full text-left text-sm report-table">
        <thead class="border-b border-slate-200 text-slate-500">
          <tr>
            <th class="py-2 pr-3 font-medium">Persona</th>
            <th class="py-2 pr-3 font-medium">Mujeres</th>
            <th class="py-2 pr-3 font-medium">Hombres</th>
            <th class="py-2 pr-3 font-medium">Total</th>
            <th class="py-2 font-medium">Fecha/hora</th>
          </tr>
        </thead>
        <tbody>
          <% official.rows.forEach(function (row) { %>
            <tr class="border-b border-slate-100">
              <td class="py-2 pr-3 font-medium"><%= row.reporterName %></td>
              <td class="py-2 pr-3"><%= row.women %></td>
              <td class="py-2 pr-3"><%= row.men %></td>
              <td class="py-2 pr-3 font-semibold"><%= row.total %></td>
              <td class="py-2"><%= formatDateTime(row.reportedAt) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr class="font-semibold border-t border-slate-200">
            <td class="pt-3 pr-3">TOTAL</td>
            <td class="pt-3 pr-3"><%= official.grand.women %></td>
            <td class="pt-3 pr-3"><%= official.grand.men %></td>
            <td class="pt-3 pr-3"><%= official.grand.total %></td>
            <td class="pt-3"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>
</section>

<!-- Modal detalle / auditoría -->
<div
  id="reporter-detail-modal"
  class="fixed inset-0 z-50 hidden items-end justify-center bg-slate-900/50 p-4 no-print sm:items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reporter-detail-title"
  aria-hidden="true"
>
  <div class="flex max-h-[85vh] w-full max-w-lg flex-col overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-200">
    <div class="flex items-start justify-between gap-3 border-b border-slate-100 bg-slate-50 px-5 py-4">
      <div>
        <p id="reporter-detail-title" class="text-lg font-bold text-brand-900">Detalle</p>
        <p class="mt-0.5 text-xs text-slate-500">Auditoría de totales enviados</p>
      </div>
      <button
        type="button"
        id="reporter-detail-close"
        class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50"
      >
        Cerrar
      </button>
    </div>
    <div id="reporter-detail-body" class="overflow-y-auto px-5 py-4"></div>
  </div>
</div>

<script src="/js/admin-reporter-detail.js" defer></script>
