<section class="mx-auto max-w-lg">
  <%- include('../partials/back-link', { backHref: '/menu', backLabel: 'Volver al menú' }) %>

  <div style="border:2px solid #fca5a5;background:#fff1f2;border-radius:1rem;padding:1.25rem;">
    <h1 style="margin:0;font-size:1.5rem;font-weight:800;color:#881337;">Resetear base de datos</h1>
    <p style="margin:0.75rem 0 0;font-size:0.95rem;line-height:1.5;color:#9f1239;">
      <strong>Advertencia:</strong> se eliminarán <strong>todos los votos</strong>
      (tiempo real y totales) de <strong>todas las personas</strong>. No se puede deshacer.
    </p>
    <p style="margin:0.5rem 0 0;font-size:0.9rem;color:#9f1239;">
      Registros actuales: <strong><%= totalDocs %></strong>
    </p>
  </div>

  <form
    id="reset-form"
    action="/dashboard/admin/reset"
    method="POST"
    style="margin-top:1.25rem;border:1px solid #e2e8f0;background:#fff;border-radius:1rem;padding:1.25rem;display:grid;gap:1rem;"
  >
    <label style="display:flex;gap:0.75rem;align-items:flex-start;border:1px solid #fecdd3;background:#fff1f2;border-radius:0.75rem;padding:0.85rem;font-size:0.9rem;color:#9f1239;">
      <input
        id="confirmDelete"
        name="confirmDelete"
        type="checkbox"
        value="yes"
        required
        style="margin-top:0.2rem;width:1.1rem;height:1.1rem;flex-shrink:0;"
      />
      <span>
        Confirmo que quiero borrar <strong>todos los votos</strong> de la base de datos.
      </span>
    </label>

    <div>
      <label for="securityCode" style="display:block;margin-bottom:0.4rem;font-size:0.9rem;font-weight:600;color:#334155;">
        Código de confirmación
      </label>
      <input
        id="securityCode"
        name="securityCode"
        type="password"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="12"
        required
        autocomplete="off"
        placeholder="Código de administrador"
        class="field-input"
        style="width:100%;box-sizing:border-box;border:2px solid #cbd5e1;border-radius:0.75rem;padding:0.75rem 0.9rem;font-size:1.1rem;"
      />
      <p style="margin:0.4rem 0 0;font-size:0.75rem;color:#64748b;">
        Es la misma contraseña/código del administrador.
      </p>
    </div>

    <div style="display:flex;flex-direction:column;gap:0.65rem;">
      <button
        id="btn-reset"
        type="submit"
        style="width:100%;border:none;border-radius:0.75rem;background:#b91c1c;color:#fff;padding:0.9rem 1rem;font-size:1.05rem;font-weight:800;cursor:pointer;"
      >
        Confirmar borrado
      </button>
      <a
        href="/menu"
        style="display:block;width:100%;box-sizing:border-box;text-align:center;border:2px solid #cbd5e1;border-radius:0.75rem;background:#fff;color:#334155;padding:0.85rem 1rem;font-size:1rem;font-weight:700;text-decoration:none;"
      >
        Cancelar
      </a>
    </div>
  </form>
</section>

<script>
  (() => {
    const form = document.getElementById('reset-form');
    const checkbox = document.getElementById('confirmDelete');
    const codeInput = document.getElementById('securityCode');
    const btn = document.getElementById('btn-reset');

    function refresh() {
      const ok = checkbox.checked && /^\d+$/.test(String(codeInput.value || '').trim());
      btn.disabled = !ok;
      btn.style.opacity = ok ? '1' : '0.55';
      btn.style.cursor = ok ? 'pointer' : 'not-allowed';
    }

    checkbox.addEventListener('change', refresh);
    codeInput.addEventListener('input', () => {
      codeInput.value = String(codeInput.value || '').replace(/\D/g, '');
      refresh();
    });

    form.addEventListener('submit', (event) => {
      if (!checkbox.checked || !/^\d+$/.test(String(codeInput.value || '').trim())) {
        event.preventDefault();
        alert('Marca la casilla e introduce el código de confirmación.');
        return;
      }
      const sure = window.confirm(
        'ÚLTIMA CONFIRMACIÓN\n\nSe borrarán TODOS los votos.\n¿Deseas continuar?'
      );
      if (!sure) event.preventDefault();
    });

    refresh();
  })();
</script>
