<section class="mx-auto max-w-lg">
  <%- include('../partials/back-link', { backHref: '/menu', backLabel: 'Volver al menú' }) %>

  <div class="rounded-2xl border-2 border-rose-300 bg-rose-50 p-5 shadow-sm">
    <h1 class="text-2xl font-bold text-rose-900">Resetear base de datos</h1>
    <p class="mt-3 text-sm leading-relaxed text-rose-900">
      <strong>Advertencia:</strong> esta acción eliminará
      <strong>todos los votos</strong> (tiempo real y totales finales) de
      <strong>todas las personas</strong>. No se puede deshacer.
    </p>
    <p class="mt-2 text-sm text-rose-800">
      Registros actuales en la base:
      <strong><%= totalDocs %></strong>
    </p>
  </div>

  <!-- Paso 1: confirmación explícita -->
  <div id="reset-step-1" class="mt-5 space-y-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-sm text-slate-700">
      Para continuar debes confirmar que quieres borrar toda la información de votación.
    </p>
    <div class="flex flex-col gap-2 sm:flex-row">
      <a href="/menu" class="action-btn action-btn-secondary w-full sm:w-auto text-center">
        Cancelar
      </a>
      <button
        type="button"
        id="btn-confirm-step"
        class="w-full rounded-xl bg-rose-700 px-4 py-3 text-base font-bold text-white hover:bg-rose-800 sm:w-auto"
      >
        Sí, quiero continuar
      </button>
    </div>
  </div>

  <!-- Paso 2: código + envío -->
  <form
    id="reset-form"
    action="/dashboard/admin/reset"
    method="POST"
    class="mt-5 hidden space-y-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
  >
    <input type="hidden" name="confirmDelete" value="yes" />

    <p class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-3 text-sm text-amber-900">
      Confirmaste el borrado. Introduce el código de administrador para ejecutar la acción.
    </p>

    <div>
      <label for="securityCode" class="mb-1.5 block text-sm font-medium text-slate-700">
        Código de seguridad
      </label>
      <input
        id="securityCode"
        name="securityCode"
        type="password"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="12"
        required
        autocomplete="off"
        placeholder="Introduce el código"
        class="field-input"
      />
      <p class="mt-1.5 text-xs text-slate-500">Debe coincidir con la contraseña de administrador.</p>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row">
      <button
        type="button"
        id="btn-back-step"
        class="action-btn action-btn-secondary w-full sm:w-auto text-center"
      >
        Volver
      </button>
      <button
        id="btn-reset"
        type="submit"
        class="w-full rounded-xl bg-rose-700 px-4 py-3 text-base font-bold text-white hover:bg-rose-800 sm:w-auto"
        disabled
      >
        Confirmar borrado definitivo
      </button>
    </div>
  </form>
</section>

<script>
  (() => {
    const step1 = document.getElementById('reset-step-1');
    const form = document.getElementById('reset-form');
    const codeInput = document.getElementById('securityCode');
    const btnStep = document.getElementById('btn-confirm-step');
    const btnBack = document.getElementById('btn-back-step');
    const btn = document.getElementById('btn-reset');

    function refresh() {
      const ok = /^\d+$/.test(codeInput.value.trim());
      btn.disabled = !ok;
      btn.style.opacity = ok ? '1' : '0.5';
    }

    btnStep.addEventListener('click', () => {
      const sure = window.confirm(
        'ÚLTIMA CONFIRMACIÓN\n\nSe borrarán TODOS los votos de la base de datos.\n¿Deseas continuar?'
      );
      if (!sure) return;
      step1.classList.add('hidden');
      form.classList.remove('hidden');
      codeInput.focus();
    });

    btnBack.addEventListener('click', () => {
      form.classList.add('hidden');
      step1.classList.remove('hidden');
      codeInput.value = '';
      refresh();
    });

    codeInput.addEventListener('input', () => {
      codeInput.value = codeInput.value.replace(/\D/g, '');
      refresh();
    });

    form.addEventListener('submit', (event) => {
      if (!/^\d+$/.test(codeInput.value.trim())) {
        event.preventDefault();
        return;
      }
      const sure = window.confirm(
        'Se eliminarán todos los registros ahora.\n¿Confirmas el borrado definitivo?'
      );
      if (!sure) event.preventDefault();
    });

    refresh();
  })();
</script>
