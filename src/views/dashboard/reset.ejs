<section class="mx-auto max-w-lg">
  <%- include('../partials/back-link', { backHref: '/menu', backLabel: 'Volver al menú' }) %>

  <div class="rounded-2xl border-2 border-rose-300 bg-rose-50 p-5 shadow-sm">
    <h1 class="text-2xl font-bold text-rose-900">Resetear base de datos</h1>
    <p class="mt-3 text-sm leading-relaxed text-rose-900">
      <strong>Advertencia:</strong> se eliminarán <strong>todos los votos</strong>
      (tiempo real y totales) de <strong>todas las personas</strong>. No se puede deshacer.
    </p>
    <p class="mt-2 text-sm text-rose-800">
      Registros actuales: <strong><%= totalDocs %></strong>
    </p>
  </div>

  <div id="reset-form-error" class="mt-4 hidden rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900" role="alert"></div>

  <form
    id="reset-form"
    action="/dashboard/admin/reset"
    method="POST"
    class="mt-5 grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
  >
    <label class="flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 px-3 py-3 text-sm text-rose-900">
      <input
        id="confirmDelete"
        name="confirmDelete"
        type="checkbox"
        value="yes"
        required
        class="mt-1 h-4 w-4 shrink-0 accent-rose-700"
      />
      <span>
        Confirmo que quiero borrar <strong>todos los votos</strong> de la base de datos.
      </span>
    </label>

    <div>
      <label for="securityCode" class="mb-1.5 block text-sm font-semibold text-slate-700">
        Código de confirmación
      </label>
      <input
        id="securityCode"
        name="securityCode"
        type="password"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="12"
        required
        autocomplete="off"
        placeholder="Código de administrador"
        class="field-input w-full rounded-xl border-2 border-slate-300 px-3.5 py-3 text-lg"
      />
      <p class="mt-1.5 text-xs text-slate-500">
        Es la misma contraseña/código del administrador.
      </p>
    </div>

    <div class="flex flex-col gap-2.5">
      <button
        id="btn-reset"
        type="button"
        class="w-full rounded-xl bg-rose-700 px-4 py-3.5 text-base font-extrabold text-white transition hover:bg-rose-800 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Confirmar borrado
      </button>
      <a
        href="/menu"
        class="action-btn action-btn-secondary w-full text-center"
      >
        Cancelar
      </a>
    </div>
  </form>
</section>

<!-- Modal de confirmación -->
<div
  id="reset-modal"
  class="fixed inset-0 z-50 hidden items-end justify-center bg-slate-900/50 p-4 sm:items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reset-modal-title"
  aria-hidden="true"
>
  <div class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-200">
    <div class="border-b border-rose-100 bg-rose-50 px-5 py-4">
      <p id="reset-modal-title" class="text-lg font-bold text-rose-900">¿Borrar todos los votos?</p>
      <p class="mt-1 text-sm leading-relaxed text-rose-800">
        Esta acción eliminará <strong>todos</strong> los reportes de tiempo real y totales finales.
        <span class="font-semibold">No se puede deshacer.</span>
      </p>
    </div>
    <div class="flex flex-col gap-2 px-5 py-4 sm:flex-row-reverse">
      <button
        type="button"
        id="reset-modal-confirm"
        class="w-full rounded-xl bg-rose-700 px-4 py-3 text-sm font-bold text-white hover:bg-rose-800 sm:w-auto sm:min-w-[10rem]"
      >
        Sí, borrar todo
      </button>
      <button
        type="button"
        id="reset-modal-cancel"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 sm:w-auto sm:min-w-[8rem]"
      >
        Volver
      </button>
    </div>
  </div>
</div>

<script>
  (() => {
    const form = document.getElementById('reset-form');
    const checkbox = document.getElementById('confirmDelete');
    const codeInput = document.getElementById('securityCode');
    const btn = document.getElementById('btn-reset');
    const errorBox = document.getElementById('reset-form-error');
    const modal = document.getElementById('reset-modal');
    const modalConfirm = document.getElementById('reset-modal-confirm');
    const modalCancel = document.getElementById('reset-modal-cancel');

    function refresh() {
      const ok = checkbox.checked && /^\d+$/.test(String(codeInput.value || '').trim());
      btn.disabled = !ok;
    }

    function showError(message) {
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hideError() {
      errorBox.classList.add('hidden');
      errorBox.textContent = '';
    }

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modalConfirm.focus();
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      btn.focus();
    }

    function isValid() {
      return checkbox.checked && /^\d+$/.test(String(codeInput.value || '').trim());
    }

    checkbox.addEventListener('change', () => {
      hideError();
      refresh();
    });

    codeInput.addEventListener('input', () => {
      codeInput.value = String(codeInput.value || '').replace(/\D/g, '');
      hideError();
      refresh();
    });

    btn.addEventListener('click', () => {
      hideError();
      if (!isValid()) {
        showError('Marca la casilla e introduce el código de confirmación.');
        return;
      }
      openModal();
    });

    modalCancel.addEventListener('click', closeModal);

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    modalConfirm.addEventListener('click', () => {
      if (!isValid()) {
        closeModal();
        showError('Marca la casilla e introduce el código de confirmación.');
        return;
      }
      modalConfirm.disabled = true;
      modalConfirm.textContent = 'Borrando…';
      form.submit();
    });

    refresh();
  })();
</script>
