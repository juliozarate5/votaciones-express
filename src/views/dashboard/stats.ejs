<section>
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between no-print">
    <div>
      <%- include('../partials/back-link', { backHref: '/dashboard/admin', backLabel: 'Volver al reporte' }) %>
      <h1 class="mt-1 text-2xl font-semibold text-brand-900">Dashboard estadístico</h1>
      <p class="mt-1 text-sm text-slate-600">Totales reportados por persona y género.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/dashboard/admin/export/excel" class="action-btn action-btn-secondary">Excel</a>
      <a href="/dashboard/admin/export/pdf" class="action-btn action-btn-secondary">PDF</a>
      <button type="button" onclick="window.print()" class="action-btn action-btn-primary">Imprimir</button>
    </div>
  </div>

  <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="stat-box">
      <p class="stat-label">Reporteros</p>
      <p class="stat-value"><%= charts.reporters %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">Mujeres</p>
      <p class="stat-value text-brand-700"><%= charts.grand.women %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">Hombres</p>
      <p class="stat-value text-brand-700"><%= charts.grand.men %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">Total</p>
      <p class="stat-value text-accent-500"><%= charts.grand.total %></p>
    </div>
  </div>

  <% if (!charts.reporters) { %>
    <p class="rounded-2xl border border-dashed border-slate-200 bg-white/80 p-8 text-center text-sm text-slate-500">
      Aún no hay datos para graficar.
    </p>
  <% } else { %>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="chart-card lg:col-span-2">
        <h2 class="chart-title">Totales por persona</h2>
        <canvas id="chartByUser" height="220"></canvas>
      </div>
      <div class="chart-card">
        <h2 class="chart-title">Distribución por género</h2>
        <canvas id="chartGender" height="220"></canvas>
      </div>
    </div>
  <% } %>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
<script>
  window.__ADMIN_CHARTS__ = <%- chartsJson %>;
</script>
<script src="/js/admin-charts.js" defer></script>
