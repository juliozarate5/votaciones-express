<section>
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between no-print">
    <div>
      <%- include('../partials/back-link', { backHref: '/dashboard/admin', backLabel: 'Volver al reporte' }) %>
      <h1 class="mt-1 text-2xl font-semibold text-brand-900">Dashboard estadístico</h1>
      <p class="mt-1 text-sm text-slate-600">Gráficos por usuario, género y tipo de reporte.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/dashboard/admin/export/excel" class="action-btn action-btn-secondary">Excel</a>
      <a href="/dashboard/admin/export/pdf" class="action-btn action-btn-secondary">PDF</a>
      <button type="button" onclick="window.print()" class="action-btn action-btn-primary">Imprimir</button>
    </div>
  </div>

  <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="stat-box">
      <p class="stat-label">Reporteros</p>
      <p class="stat-value"><%= charts.reporters %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">RT Total</p>
      <p class="stat-value text-accent-500"><%= charts.grand.realtimeTotal %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">Final Total</p>
      <p class="stat-value text-accent-500"><%= charts.grand.totalVotes %></p>
    </div>
    <div class="stat-box">
      <p class="stat-label">Combinado*</p>
      <p class="stat-value"><%= charts.grand.realtimeTotal + charts.grand.totalVotes %></p>
    </div>
  </div>
  <p class="mb-6 text-xs text-slate-500">* Combinado suma ambos modos solo como referencia; no implica un único conteo oficial.</p>

  <% if (!summary.rows.length) { %>
    <p class="rounded-2xl border border-dashed border-slate-200 bg-white/80 p-8 text-center text-sm text-slate-500">
      Aún no hay datos para graficar.
    </p>
  <% } else { %>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="chart-card">
        <h2 class="chart-title">Tiempo real por usuario</h2>
        <canvas id="chartUserRealtime" height="220"></canvas>
      </div>
      <div class="chart-card">
        <h2 class="chart-title">Total final por usuario</h2>
        <canvas id="chartUserFinal" height="220"></canvas>
      </div>
      <div class="chart-card">
        <h2 class="chart-title">Género — tiempo real</h2>
        <canvas id="chartGenderRealtime" height="220"></canvas>
      </div>
      <div class="chart-card">
        <h2 class="chart-title">Género — total final</h2>
        <canvas id="chartGenderFinal" height="220"></canvas>
      </div>
      <div class="chart-card lg:col-span-2">
        <h2 class="chart-title">Comparación de modos de reporte</h2>
        <div class="mx-auto max-w-xl">
          <canvas id="chartModes" height="180"></canvas>
        </div>
      </div>
    </div>
  <% } %>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
<script>
  window.__ADMIN_CHARTS__ = <%- chartsJson %>;
</script>
<script src="/js/admin-charts.js" defer></script>
