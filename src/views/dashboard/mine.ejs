<section>
  <div class="mb-6">
    <%- include('../partials/back-link', { backHref: '/menu', backLabel: 'Volver al menú' }) %>
    <h1 class="mt-1 text-2xl font-semibold text-brand-900">Mi reporte</h1>
    <p class="mt-1 text-sm text-slate-600">Totales actuales e historial de envíos.</p>
  </div>

  <% 
    const currentFemale = summary.latestFinal ? summary.latestFinal.women : summary.realtime.female;
    const currentMale = summary.latestFinal ? summary.latestFinal.men : summary.realtime.male;
    const currentTotal = summary.latestFinal ? summary.latestFinal.total : summary.realtime.total;
    const updatedAt = summary.latestFinal
      ? (summary.latestFinal.createdAt || summary.latestFinal.syncedAt)
      : summary.realtime.lastAt;
  %>

  <div class="mb-6 rounded-2xl border border-brand-100 bg-white/90 p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-brand-900">Total actual (válido)</h2>
    <div class="mt-4 grid grid-cols-3 gap-3">
      <div class="stat-box">
        <p class="stat-label">Mujeres</p>
        <p class="stat-value"><%= currentFemale %></p>
      </div>
      <div class="stat-box">
        <p class="stat-label">Hombres</p>
        <p class="stat-value"><%= currentMale %></p>
      </div>
      <div class="stat-box">
        <p class="stat-label">Total</p>
        <p class="stat-value text-accent-500"><%= currentTotal %></p>
      </div>
    </div>
    <% if (currentTotal > 0 && updatedAt) { %>
      <p class="mt-3 text-sm text-slate-600">
        Actualizado: <strong class="text-brand-900"><%= formatDateTime(updatedAt) %></strong>
      </p>
    <% } else if (currentTotal === 0) { %>
      <p class="mt-3 text-sm text-slate-500">Aún no hay votos registrados.</p>
    <% } %>
  </div>

  <div class="rounded-2xl border border-brand-100 bg-white/90 p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-brand-900">Historial de totales enviados</h2>
    <% if (!summary.totals.length) { %>
      <p class="mt-3 text-sm text-slate-500">Aún no has enviado un total por “Reportar solo totales”.</p>
    <% } else { %>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="border-b border-slate-200 text-slate-500">
            <tr>
              <th class="py-2 pr-3 font-medium">Fecha y hora</th>
              <th class="py-2 pr-3 font-medium">Mujeres</th>
              <th class="py-2 pr-3 font-medium">Hombres</th>
              <th class="py-2 font-medium">Total</th>
            </tr>
          </thead>
          <tbody>
            <% summary.totals.forEach(function (row, idx) { %>
              <tr class="border-b border-slate-100 <%= idx === summary.totals.length - 1 ? 'bg-emerald-50/80' : '' %>">
                <td class="py-2 pr-3">
                  <%= formatDateTime(row.createdAt || row.syncedAt) %>
                  <% if (idx === summary.totals.length - 1) { %>
                    <span class="ml-1 text-xs font-bold text-emerald-700">(válido)</span>
                  <% } %>
                </td>
                <td class="py-2 pr-3"><%= row.women %></td>
                <td class="py-2 pr-3"><%= row.men %></td>
                <td class="py-2 font-semibold"><%= row.total %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-500">
        El último envío es el válido. Los votos a voto posteriores se suman a ese total.
      </p>
    <% } %>
  </div>
</section>
