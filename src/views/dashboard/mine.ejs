<section>
  <div class="mb-6">
    <%- include('../partials/back-link', { backHref: '/menu', backLabel: 'Volver al menú' }) %>
    <h1 class="mt-1 text-2xl font-semibold text-brand-900">Mi reporte</h1>
    <p class="mt-1 text-sm text-slate-600">Totales que tienes reportados.</p>
  </div>

  <% 
    const currentFemale = summary.latestFinal ? summary.latestFinal.women : summary.realtime.female;
    const currentMale = summary.latestFinal ? summary.latestFinal.men : summary.realtime.male;
    const currentTotal = summary.latestFinal ? summary.latestFinal.total : summary.realtime.total;
    const updatedAt = summary.latestFinal
      ? (summary.latestFinal.createdAt || summary.latestFinal.syncedAt)
      : summary.realtime.lastAt;
  %>

  <div class="rounded-2xl border border-brand-100 bg-white/90 p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-brand-900">Totales reportados</h2>
    <div class="mt-4 grid grid-cols-3 gap-3">
      <div class="stat-box">
        <p class="stat-label">Mujeres</p>
        <p class="stat-value"><%= currentFemale %></p>
      </div>
      <div class="stat-box">
        <p class="stat-label">Hombres</p>
        <p class="stat-value"><%= currentMale %></p>
      </div>
      <div class="stat-box">
        <p class="stat-label">Total</p>
        <p class="stat-value text-accent-500"><%= currentTotal %></p>
      </div>
    </div>
    <% if (currentTotal > 0) { %>
      <% if (updatedAt) { %>
        <p class="mt-3 text-sm text-slate-600">
          Actualizado: <strong class="text-brand-900"><%= formatDateTime(updatedAt) %></strong>
        </p>
      <% } %>
    <% } else { %>
      <p class="mt-3 text-sm text-slate-500">Aún no hay votos registrados.</p>
    <% } %>
  </div>
</section>
