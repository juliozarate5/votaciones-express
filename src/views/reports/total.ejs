<section class="mx-auto max-w-md">
  <div class="mb-6">
    <%- include('../partials/back-link', { backHref: '/menu', backLabel: 'Volver al menú' }) %>
    <h1 class="mt-1 text-2xl font-semibold text-brand-900">Reportar solo totales</h1>
    <p class="mt-1 text-sm text-slate-600">
      Envía mujeres, hombres y total de una vez. Esto queda como el reporte válido y reinicia el conteo voto a voto.
    </p>
  </div>

  <% if (realtimeCounts && realtimeCounts.total > 0) { %>
    <div class="mb-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      Tienes <strong><%= realtimeCounts.total %></strong> voto(s) a voto
      (<%= realtimeCounts.female %> mujeres, <%= realtimeCounts.male %> hombres).
      Al guardar este total, ese conteo se reiniciará.
    </div>
  <% } %>

  <% if (latestFinal) { %>
    <div class="mb-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
      Ya hay un total final válido:
      <strong><%= latestFinal.women %></strong> mujeres,
      <strong><%= latestFinal.men %></strong> hombres,
      <strong><%= latestFinal.total %></strong> total.
      Puedes enviar otro; el nuevo será el válido.
    </div>
  <% } %>

  <form id="total-form" action="/report/total" method="POST" class="space-y-4 rounded-2xl border border-brand-100 bg-white/90 p-6 shadow-sm">
    <div>
      <label for="total" class="mb-1.5 block text-sm font-medium text-slate-700">Cantidad total de votos</label>
      <input id="total" name="total" type="number" min="0" step="1" required class="field-input" />
    </div>
    <div>
      <label for="women" class="mb-1.5 block text-sm font-medium text-slate-700">Cantidad de mujeres</label>
      <input id="women" name="women" type="number" min="0" step="1" required class="field-input" />
    </div>
    <div>
      <label for="men" class="mb-1.5 block text-sm font-medium text-slate-700">Cantidad de hombres</label>
      <input id="men" name="men" type="number" min="0" step="1" required class="field-input" />
    </div>
    <p id="total-hint" class="rounded-xl bg-brand-50 px-3 py-2 text-sm text-brand-700">
      Tip: escribe el total y un género; el otro se completa solo.
    </p>
    <p id="total-error" class="hidden text-sm text-rose-600">Mujeres + hombres debe ser igual al total.</p>
    <p id="total-feedback" class="min-h-[1.25rem] text-sm text-slate-600" aria-live="polite"></p>
    <button type="submit" class="w-full rounded-xl bg-brand-700 px-4 py-3 text-base font-semibold text-white hover:bg-brand-900 transition">
      Guardar total final
    </button>
  </form>

  <script id="total-context" type="application/json"><%- JSON.stringify({
    realtimeTotal: realtimeCounts ? realtimeCounts.total : 0,
    hasFinal: Boolean(latestFinal),
  }) %></script>
</section>

<script src="/js/total-form.js" defer></script>
